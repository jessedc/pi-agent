# Copy to .env and fill in. .env is gitignored — never commit a real credential.
#
# Nothing in this file has a default. Every variable below that is not marked
# optional must be set: the host CLI stops and names the ones that are not,
# rather than falling back to a value nobody chose.

# ---- required -------------------------------------------------------------
# The repository the bot works on when a run does not name one. It clones this,
# reads one issue from it, and pushes one branch plus one draft PR back to it.
# `pi-agent owner/repo 12` targets a different repository for one run, so this
# may be left unset if every run names its own.
GITHUB_REPOSITORY=example/agent-demo

# ---- credential: the GitHub App ------------------------------------------
# The bot appears as `your-app[bot]`. No second account, and no human token:
# the installation token is minted per run and lives one hour.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/agent-demo-bot.pem

# Optional: skip the installation lookup by pinning the id. It belongs to the
# repository above; a run that names a different one looks its installation up.
#GITHUB_APP_INSTALLATION_ID=87654321

# ---- the run --------------------------------------------------------------
# Image tag to build and run.
IMAGE=pi-issue-to-pr:local

# Host directory for pi session transcripts, filed as <owner>/<repo>/issue-<n>.
# The repository's directory is mounted at /work/sessions in the container.
# Relative to this file.
SESSIONS_DIR=./sessions

# Bare name of the definition under .pi/agents/; no path or .md extension.
AGENT=issue-to-pr

# ---- the container's budget ---------------------------------------------
# What one run may consume, in `docker run`'s units. The model's bash tool can
# loop, fork and allocate without bound; these make that the container's
# problem rather than the host's. Memory and CPU depend on the machine the
# daemon runs on, and the pid limit on how parallel the target project's own
# gate is, so none of them has a default. Zero is refused: to docker it means
# "no limit". The clone and the home directory are in-memory filesystems that
# count against CONTAINER_MEMORY, so leave room for them.
CONTAINER_MEMORY=4g
CONTAINER_CPUS=4
CONTAINER_PIDS_LIMIT=500

# The model process's deadline, in seconds, enforced inside the container. At
# the deadline pi is told to stop and given time to write its transcript; the
# run then reconciles the remote as it would after any exit, so an orphaned
# branch is still deleted. The installation token lives one hour, so a run
# that outlasts it could not push anyway.
RUN_TIMEOUT=3600

# ---- the model ------------------------------------------------------------
# These generate pi's models.json and settings.json at container start, so
# changing model is an edit here and not a rebuild. The agent definition does
# not name a model; this is the only place one is chosen.

# Tailnet host serving the model, and its port. The container resolves the host
# by name: the host CLI looks its tailscale IP up and passes `--add-host`.
MODEL_HOST=model-box.example.ts.net
MODEL_PORT=8080

# Optional: skip the `tailscale ip` lookup entirely.
#MODEL_IP=100.64.0.1

# ---- egress -----------------------------------------------------------------
# The container can open connections to the model above, to GitHub, and to the
# resolver docker gives it -- nothing else. The rules are installed inside the
# container before privileges are dropped, and the model cannot loosen them.
#
# Optional: host names the target project's own gate needs, such as its
# package registries, comma-separated. Each is resolved once at container
# start and allowed on port 443 only. Unset, nothing else is reachable, and a
# project that installs dependencies will fail to. Every name here is a place
# the token and the checkout could be sent, so list what the project needs and
# no more.
#EGRESS_ALLOW=pypi.org,files.pythonhosted.org,registry.npmjs.org

# The provider entry pi registers. MODEL_API is the wire protocol; local
# llama.cpp speaks OpenAI completions and wants no key.
MODEL_PROVIDER=llamacpp
MODEL_API=openai-completions
MODEL_API_KEY=no-api-key

# llama.cpp's OpenAI shim has no `developer` role; a hosted OpenAI-compatible
# endpoint generally does.
MODEL_SUPPORTS_DEVELOPER_ROLE=false

# The model itself. MODEL_ID is what the server serves and what pi asks for;
# MODEL_NAME is only ever shown to a human.
MODEL_ID=DeepSeek-V4-Flash-0731-UD-IQ2_M
MODEL_NAME="DeepSeek V4 Flash 0731 (GB10)"
MODEL_CONTEXT_WINDOW=262144
MODEL_REASONING=true

# Thinking level for the run: pi's default and the agent's `--thinking`.
THINKING_LEVEL=high
